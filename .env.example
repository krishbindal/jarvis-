# JARVIS-X environment configuration (copy to .env and fill in).
# Never commit your real .env.

# --- AI providers ---
MODEL_NAME=llama3
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Voice ---
VOICE_MODEL_PATH=voice/model
WAKE_WORD=jarvis
# OpenWakeWord pretrained model name (provision separately)
WAKE_MODEL_NAME=hey jarvis

# --- Email (use a Gmail App Password, not your login password) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- n8n integration ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/action
N8N_NOTIFY_HOST=127.0.0.1
N8N_NOTIFY_PORT=5001
# Required to enable the local notification server. Generate a random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Leave empty to keep the server disabled.
N8N_NOTIFY_TOKEN=
# Basic-auth credentials for the n8n docker container.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# --- Security controls (opt-in; all default OFF/safe) ---
# Allow file operations outside SAFE_DIRECTORIES.
JARVIS_ALLOW_UNRESTRICTED_FS=0
# DANGER: opted-in Python runs with your normal Windows permissions, not in an OS sandbox.
# Only enable for code you have inspected/approved.
JARVIS_ALLOW_CODE_EXECUTION=0
# Send clipboard contents to cloud LLMs for proactive analysis.
JARVIS_ENABLE_CLIPBOARD_MONITOR=0
# API keys do not imply consent to share microphone, screen or clipboard data.
JARVIS_ALLOW_CLOUD_STT=0
JARVIS_ALLOW_CLOUD_VISION=0
JARVIS_ALLOW_CLOUD_CLIPBOARD=0
JARVIS_REMEMBER_CLIPBOARD=0
JARVIS_ALLOW_LOCAL_SCREEN_SNAPSHOTS=0
# Store raw spoken/typed command text in logs (privacy-sensitive).
JARVIS_LOG_COMMAND_TEXT=0
# Allow auto pip-install of allow-listed missing modules.
JARVIS_ALLOW_AUTO_PIP=0

# --- Downloads ---
# JARVIS_DOWNLOAD_DIR=~/Downloads
# JARVIS_MAX_DOWNLOAD_BYTES=524288000

# Optional background services (disabled by default)
JARVIS_ENABLE_BACKGROUND_VISION=0
JARVIS_ENABLE_PROACTIVE=0
JARVIS_ENABLE_AUTONOMY=0
JARVIS_ENABLE_FILE_ORGANIZER=0
JARVIS_ENABLE_KNOWLEDGE_INDEXER=0
JARVIS_ENABLE_SENTINEL=0
JARVIS_ENABLE_SYSTEM_MONITOR=0
# MCP starts configured subprocesses; install requirements-mcp.txt and review server commands.
JARVIS_ENABLE_MCP_HUB=0
